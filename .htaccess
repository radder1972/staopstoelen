# Set DirectoryIndex to prefer modern static HTML over legacy PHP
DirectoryIndex index.html index.php

# Disable LiteSpeed Server Cache for static site
<IfModule LiteSpeed>
    CacheDisable
</IfModule>

# Force Anti-Cache for HTML, CSS, JS and API responses
<IfModule mod_headers.c>
    <FilesMatch "\.(html|htm|js|css|php|json)$">
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0, post-check=0, pre-check=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
</IfModule>

# Afbeeldingen: browsercache van 7 dagen + Vary zodat WebP/PNG niet door elkaar lopen
<IfModule mod_headers.c>
    <FilesMatch "\.(png|jpe?g|webp|svg)$">
        Header set Cache-Control "public, max-age=604800"
        Header append Vary Accept
    </FilesMatch>
</IfModule>

# ----------------------------------------------------------------------
# Rewrite Engine & SEO Canonicalization
# ----------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Disable LiteSpeed Cache via Rewrite Environment
    RewriteRule .* - [E=Cache-Control:no-cache]

    # Rule 1: Canonicalize Domain & Protocol (Force HTTPS & Non-WWW)
    # Redirects any http:// or www. requests to https://staopstoelen.nl/
    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP:X-Forwarded-Proto} =http [OR]
    RewriteCond %{HTTP_HOST} ^www\. [NC]
    RewriteRule ^(.*)$ https://staopstoelen.nl/$1 [R=301,L]

    # Rule 2: Prevent /index.html and /index.php direct access (canonicalize to /)
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.(html|php) [NC]
    RewriteRule ^index\.(html|php)$ / [R=301,L]

    # Rule 3: Campaign & Review Shortcuts (Direct 302 redirects)
    RewriteRule ^(google-)?review(\.html)?/?$ https://g.page/r/CYF_zuQphK3aEAE/review [R=302,NE,L]
    RewriteRule ^(najaars)?actie/?$ /?utm_source=flyer&utm_medium=print&utm_campaign=najaarsactie [R=302,NE,L]
    RewriteRule ^flyer/?$ /?utm_source=flyer&utm_medium=print&utm_campaign=najaarsactie [R=302,NE,L]

    # Rule 4: Business card aliases & legacy redirects
    RewriteRule ^visitekaartje-geertjan(\.html)?$ /visitekaartje.html [L]
    RewriteRule ^huisstijl(\.html)?/?$ /beheer.html#huisstijl [R=301,NE,L]

    # Regio landing page aliases (e.g. /sta-op-stoelen/dordrecht or /sta-op-stoel/dordrecht -> /sta-op-stoel-dordrecht.html)
    RewriteRule ^sta-op-stoel(?:en)?/([a-zA-Z0-9-]+)/?$ /sta-op-stoel-$1.html [R=301,L]
    RewriteRule ^sta-op-stoelen-([a-zA-Z0-9-]+)/?$ /sta-op-stoel-$1.html [R=301,L]

    # Rule 4b: Serveer automatisch de lichte WebP-versie (bestand.png.webp / bestand.jpg.webp)
    # aan browsers die WebP ondersteunen. De originele PNG/JPG blijft het fallback-bestand.
    RewriteCond %{HTTP_ACCEPT} image/webp
    RewriteCond %{DOCUMENT_ROOT}/$0.webp -f
    RewriteRule ^assets/.+\.(png|jpe?g)$ $0.webp [T=image/webp,L]

    # Rule 5: Exclude API, assets, and actual existing files and directories
    RewriteRule ^api/ - [L]
    RewriteRule ^assets/ - [L]
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Rule 6: Clean URL rewriting without .html extension (e.g. /keuzehulp -> /keuzehulp.html)
    RewriteCond %{DOCUMENT_ROOT}/$1.html -f
    RewriteRule ^([^/]+)/?$ $1.html [L]

    # Rule 7: Subdirectory clean URL rewrite (e.g. /stoelen/sta-op-stoel-alfred -> /stoelen/sta-op-stoel-alfred.html)
    RewriteCond %{DOCUMENT_ROOT}/$1/$2.html -f
    RewriteRule ^([^/]+)/([^/]+)/?$ $1/$2.html [L]

    # Rule 8: 301 Permanent SEO Redirect for legacy dead links to staopstoelen.html
    RewriteRule ^.*$ /staopstoelen.html [R=301,L]
</IfModule>

# Fallback 404 handler
ErrorDocument 404 /staopstoelen.html
