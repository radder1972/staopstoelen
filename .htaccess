# Force Anti-Cache for HTML, CSS, JS and API responses
<IfModule mod_headers.c>
    <FilesMatch "\.(html|htm|js|css|php|json)$">
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0, post-check=0, pre-check=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
</IfModule>

# 301 SEO Redirects for old Google search links -> staopstoelen.html
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Exclude existing valid files and directories
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Exclude API folder and static assets from redirecting
    RewriteRule ^api/ - [L]
    RewriteRule ^assets/ - [L]

    # Redirect legacy /huisstijl and /huisstijl.html to beheer.html#huisstijl
    RewriteRule ^huisstijl(\.html)?/?$ /beheer.html#huisstijl [R=301,NE,L]

    # Rewrite clean URLs without .html extension (e.g. /keuzehulp -> /keuzehulp.html)
    RewriteCond %{DOCUMENT_ROOT}/$1.html -f
    RewriteRule ^([^/]+)/?$ $1.html [L]

    # Alias for Geertjan's business card (serves visitekaartje.html directly)
    RewriteRule ^visitekaartje-geertjan(\.html)?$ /visitekaartje.html [L]

    # Redirect all non-existent old page URLs (404s / old Google search links) temporarily to staopstoelen.html
    RewriteRule ^.*$ /staopstoelen.html [R=302,L]
</IfModule>

# Fallback 404 handler
ErrorDocument 404 /staopstoelen.html
